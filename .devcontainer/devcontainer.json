{
  "name": "FRR bgpd — crypto-routes",

  // Ubuntu 22.04 matches FRR's official CI base image.
  // All build dependencies are installed by onCreateCommand below.
  "image": "ubuntu:22.04",

  // Runs once when the Codespace VM is first provisioned.
  // Installs every FRR build dep and builds libyang 3.13.6 from source.
  "onCreateCommand": "bash /workspaces/bgp-assignment/.devcontainer/setup.sh",

  // Drop straight into the repo root.
  "workspaceFolder": "/workspaces/bgp-assignment",

  "remoteUser": "root",

  "customizations": {
    "vscode": {
      "extensions": [
        // C/C++ IntelliSense — resolves FRR headers in the editor
        "ms-vscode.cpptools",
        // CMake tools — used for libyang source build in setup.sh
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        // Point IntelliSense at the FRR include dirs
        "C_Cpp.default.includePath": [
          "${workspaceFolder}",
          "${workspaceFolder}/lib",
          "${workspaceFolder}/bgpd",
          "${workspaceFolder}/include",
          "/usr/include"
        ],
        "C_Cpp.default.defines": [
          "HAVE_CONFIG_H"
        ]
      }
    }
  }
}
